{
	"extends": "https://github.com/kjanat/kjanat/raw/ba1420e/configs/dprint.remote.json",
	"useTabs": true,
	"exec": {
		"associations": ["*.rs", "*.toml"],
		"commands": [
			{ "command": "npx tombi format - --stdin-filename {{file_path}}", "exts": ["toml"] },
			{ "command": "rustfmt --edition 2024", "exts": ["rs"] },
		],
	},
	"excludes": ["tests/fixtures"],
	"plugins": [
		"https://plugins.dprint.dev/exec-0.6.2.json@df98f54ffd3092b8a841aedd6d098a2651f16d0a796a40535774f1a8b4b9d463",
	],
}
