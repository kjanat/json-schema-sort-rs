{
  "$id": "https://example.com/product.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "money": {
      "examples": [
        {
          "currency": "USD",
          "amount": 10
        }
      ],
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "title": "Product",
  "description": "A product record",
  "markdownDescription": "**A product**",
  "default": {
    "status": "draft",
    "id": "p_000"
  },
  "examples": [
    {
      "status": "active",
      "id": "p_001"
    }
  ],
  "type": [
    "null",
    "object"
  ],
  "const": {
    "kind": "product",
    "version": 1
  },
  "required": [
    "id",
    "status"
  ],
  "properties": {
    "id": {
      "title": "Identifier",
      "type": "string",
      "minLength": 1
    },
    "status": {
      "description": "Lifecycle state",
      "default": "draft",
      "type": "string",
      "enum": [
        "active",
        "archived",
        "draft"
      ],
      "markdownEnumDescriptions": [
        "**on**",
        "**gone**",
        "**wip**"
      ]
    }
  },
  "additionalProperties": false,
  "x-taplo": {
    "hidden": false
  },
  "zzz-vendor-flag": true
}
